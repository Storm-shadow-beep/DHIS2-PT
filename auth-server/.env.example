NODE_ENV=development
PORT=5000
DATABASE_URL=postgresql://postgres:password@localhost:5432/dhis2_pt

# Auth
JWT_SECRET=change_this_to_a_strong_random_secret
JWT_REFRESH_SECRET=change_this_refresh_secret
OTP_HMAC_SECRET=change_this_to_a_dedicated_otp_secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=12

# Cookie
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
REFRESH_TOKEN_COOKIE_NAME=refresh_token
REFRESH_TOKEN_MAX_AGE_MS=604800000
REMEMBER_ME_MAX_AGE_MS=2592000000

# CORS
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Rate limiting
REGISTRATION_RATE_LIMIT_WINDOW_MS=900000
REGISTRATION_RATE_LIMIT_MAX=5

# Email OTP
OTP_EMAIL_PROVIDER=resend
RESEND_API_KEY=re_xxxxxxxxx
RESEND_FROM_EMAIL=no-reply@example.com
RESEND_FROM_NAME=Project Management Software
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@localhost
SMTP_FROM_NAME=Project Management Software
# Set OTP_EMAIL_PROVIDER=file for development-only local mailbox delivery.
OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_SENDS_PER_WINDOW=5
OTP_SEND_WINDOW_MINUTES=15
PASSWORD_RESET_EXPIRY_MINUTES=60

# Optional development/bootstrap account. The account is created once and assigned project_manager.
# Seeding is skipped automatically when the role already exists in the DB.
# Set SKIP_SEED=true when sharing one database (e.g. Neon) across developers
# to skip default account seeding entirely on startup.
SKIP_SEED=false
PROJECT_MANAGER_EMAIL=
PROJECT_MANAGER_PASSWORD=

# Default administrator bootstrap. Created once on backend startup and assigned administrator.
# Defaults to admin@example.org / admin@123 when unset. Set a strong ADMIN_PASSWORD in production.
ADMIN_EMAIL=admin@example.org
ADMIN_PASSWORD=

# Google Drive integration — two modes (OAuth preferred for personal Gmail):
# A) OAuth user delegation (works with My Drive, no Shared Drive needed):
#    Set GOOGLE_OAUTH_CLIENT_ID + GOOGLE_OAUTH_CLIENT_SECRET + GOOGLE_OAUTH_REFRESH_TOKEN
#    and DRIVE_ROOT_FOLDER_ID to a regular folder ID you own.
# B) Service account + Shared Drive (requires Google Workspace):
#    Provide either GOOGLE_SERVICE_ACCOUNT_KEY_FILE (path to SA JSON key, preferred)
#    or GOOGLE_SERVICE_ACCOUNT_JSON_B64 (base64-encoded SA JSON for hosted envs),
#    plus DRIVE_SHARED_DRIVE_ID (the Shared Drive ID, not a folder ID).
# Never commit real keys. Set DRIVE_DISABLED=true for local dev without Drive.
DRIVE_DISABLED=false
DRIVE_SHARED_DRIVE_ID=
DRIVE_ROOT_FOLDER_ID=
GOOGLE_SERVICE_ACCOUNT_KEY_FILE=./secrets/drive-sa.json
GOOGLE_SERVICE_ACCOUNT_JSON_B64=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
DRIVE_UPLOAD_MAX_BYTES=52428800