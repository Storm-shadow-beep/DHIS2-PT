{
  "name": "dhis2-pt-auth-backend",
  "version": "1.0.0",
  "description": "DHIS2-PT Document Module - Auth & Authorization service (Express + TypeScript)",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test test/authorization.policy.test.js",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write \"src/**/*.{ts,json}\""
  },
  "keywords": [
    "express",
    "typescript",
    "auth",
    "jwt",
    "rbac",
    "dhis2"
  ],
  "author": "DHIS2 Tanzania - Document Module",
  "license": "MIT",
  "dependencies": {
    "@types/nodemailer": "^8.0.1",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "joi": "^18.2.8",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.12.0",
    "nodemailer": "^10.0.1",
    "pg": "^8.23.0",
    "resend": "^6.26.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/node": "^26.5.0",
    "@types/pg": "^8.23.1",
    "nodemon": "^3.1.14",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "tar": "^7.5.21",
    "qs": "^6.15.4"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "allowScripts": {
    "fsevents@2.3.3": true,
    "bcrypt@6.0.0": true
  }
}
